# 默认忽略全部文件，仅允许明确列出的站点文件与媒体进入版本控制。
/*
!/README.md
!/index.html
!/.gitignore
!/.gitattributes
!/.nojekyll
!/data/
!/media/
!/tests/
!/assets/

/assets/*
!/assets/site.css
!/assets/tree.js
!/assets/query-engine.js

/data/*
!/data/actions.json
!/data/decision-tree.json.gz

/tests/*
!/tests/smoke_browser.js

/media/*
!/media/README.md
!/media/videos/
!/media/posters/

/media/videos/*
!/media/videos/README.md
!/media/videos/*.mp4

/media/posters/*
!/media/posters/README.md
!/media/posters/*.webp
!/media/posters/*.jpg
!/media/posters/*.jpeg
!/media/posters/*.png
