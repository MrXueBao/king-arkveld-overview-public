# Deny by default. Only explicitly reviewed site files and media are trackable.
/*
!/README.md
!/index.html
!/.gitignore
!/.gitattributes
!/.nojekyll
!/data/
!/media/
!/tests/

/data/*
!/data/actions.json

/tests/*
!/tests/smoke_browser.js

/media/*
!/media/README.md
!/media/videos/
!/media/posters/

/media/videos/*
!/media/videos/README.md
!/media/videos/*.mp4

/media/posters/*
!/media/posters/README.md
!/media/posters/*.webp
!/media/posters/*.jpg
!/media/posters/*.jpeg
!/media/posters/*.png
